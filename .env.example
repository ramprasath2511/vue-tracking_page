# Base URL for the Core API tracking-by-code endpoint, read directly by
# Vite (local dev and the Docker "dev" target both use this file).
VITE_CORE_API_URL=

# Used only by the "production" Docker target (nginx), injected into
# public/config.js at container start instead of baked into the JS bundle.
CORE_API_URL=

# Optional: enables the static GPS map on the delivered timeline step.
VITE_GOOGLE_MAPS_API_KEY=
