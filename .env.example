# Base URL for the Core API tracking-by-code endpoint, read directly by
# Vite (local dev and the Docker "dev" target both use this file).
VITE_CORE_API_URL=

# Used only by the "production" Docker target (nginx), injected into
# public/config.js at container start instead of baked into the JS bundle.
CORE_API_URL=

# Optional: enables the static GPS map on the delivered timeline step.
VITE_GOOGLE_MAPS_API_KEY=

# Base URL for driver-location-service, used to fetch a live-tracking auth
# token (POST /api/auth/recipient) and, from it, derive the WebSocket URL
# for live driver location. Same runtime-config-wins-over-Vite-env pattern
# as CORE_API_URL above.
VITE_DRIVER_LOCATION_SERVICE_URL=
DRIVER_LOCATION_SERVICE_URL=

# Optional: only needed when the WebSocket server listens on a different
# port than the REST API above (e.g. local dev, where nginx and the
# websockets server are exposed on separate ports).
VITE_DRIVER_LOCATION_SERVICE_WS_PORT=
